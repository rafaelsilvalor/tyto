# Prettier is configured with endOfLine: lf, and the Husky hooks run under sh on Linux
# CI, so working copies stay LF on every platform.
* text=auto eol=lf

*.png binary
*.jpg binary
*.webp binary
*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary

# Reference renders for the visual tests live in Git LFS (docs/git-workflow.md). The
# pattern is anchored on __fixtures__ so only the snapshot corpus goes to LFS: a full
# `*.png` rule would drag every icon and doc image along, and those are small, rarely
# rewritten, and useful in a plain `git clone` without the LFS client installed.
# Checkouts that need the real bytes (ci.yml, visual.yml) pass `lfs: true`.
**/__fixtures__/**/*.png filter=lfs diff=lfs merge=lfs -text

# The one place in the repository where a line ending is the subject rather than the
# medium. `* text=auto eol=lf` above would hand every checkout an LF copy of these, which
# would leave the test that reads them asserting nothing (TYTO-68). `-text` keeps the bytes
# exactly as committed, on every platform.
tools/contract-test/src/fixture/line-endings/** -text

pnpm-lock.yaml linguist-generated=true -diff
