# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.npm/

# pnpm
.pnpm-store/
.pnpm-debug.log*

# Turborepo
.turbo/

# Build output
dist/
# An example plugin's dist/index.js is its source: an installed plugin is not built (TYTO-50).
!examples/plugins/*/dist/
build/
out/
*.tsbuildinfo

# Generated by lezer-generator; `pnpm generate` rebuilds it from the .grammar
*.parser.js
*.parser.terms.js

# tsup bundles its config into the package while building; an interrupted build leaves
# the file behind.
tsup.config.bundled_*.mjs

# Electron
release/
app/dist/
.electron-builder-cache/

# Coverage and test artifacts
coverage/
.nyc_output/
playwright-report/
test-results/
# What a `test:desktop` shard writes for the merge step in `desktop-e2e.yml` (TYTO-307).
blob-reports/

# Environment and local config
.env
.env.*
!.env.example

# Editor and OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Logs
logs/
*.log

# Visual test output: the render and the pixel diff for a reference that did not match.
# `visual.yml` uploads it as an artifact; it is never committed.
__diff__/

# VitePress's build scratch (the server bundle, the bundled config) and its default cache
# folder; the build deletes the first two on the way out (TYTO-314).
.vitepress/.temp/
.vitepress/cache/
*.timestamp-*.mjs
