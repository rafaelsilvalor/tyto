{
  "name": "@tyto/desktop",
  "private": true,
  "version": "0.7.0",
  "type": "module",
  "description": "Electron desktop application.",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build && vite build --config vite.guest.config.ts && node scripts/fetch-node.ts",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:desktop": "vitest run --config vitest.desktop.config.ts",
    "test:package": "vitest run --config vitest.package.config.ts"
  },
  "dependencies": {
    "@tyto/brief-lang": "workspace:*",
    "@tyto/core": "workspace:*",
    "@tyto/editor": "workspace:*",
    "@tyto/export-html": "workspace:*",
    "@tyto/export-svg": "workspace:*",
    "@tyto/fonts": "workspace:*",
    "@tyto/io": "workspace:*",
    "@tyto/pipeline": "workspace:*",
    "@tyto/plugin-api": "workspace:*",
    "@tyto/template-lang": "workspace:*",
    "@tyto/templates": "workspace:*",
    "electron-updater": "^6.8.9",
    "jsonc-parser": "^3.3.1",
    "lit": "^3.3.3",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@electron/fuses": "^2.1.3",
    "@types/pngjs": "^6.0.5",
    "@tyto/raster": "workspace:*",
    "electron": "^44.6.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "0.28.2",
    "jsdom": "^30.1.2",
    "pixelmatch": "^8.0.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "typescript": "^5.9.3",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  }
}
