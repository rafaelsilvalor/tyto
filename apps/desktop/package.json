{
  "name": "@tyto/desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Electron desktop application.",
  "license": "UNLICENSED",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.renderer.json && tsc --noEmit -p tsconfig.e2e.json",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:desktop": "vitest run --config vitest.desktop.config.ts",
    "test:package": "vitest run --config vitest.package.config.ts"
  },
  "dependencies": {
    "@tyto/core": "workspace:*",
    "@tyto/io": "workspace:*",
    "@tyto/plugin-api": "workspace:*",
    "@tyto/templates": "workspace:*",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "playwright": "^1.63.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  }
}
