{
  "name": "tyto",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Local-first, multi-format advertising art generator",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rafaelsilvalor/tyto.git"
  },
  "packageManager": "pnpm@11.27.0",
  "engines": {
    "node": "^22.22.2 || ^24.15 || >=26"
  },
  "scripts": {
    "dev": "turbo run dev --filter=@tyto/desktop",
    "cli": "turbo run build --filter=@tyto/cli && node apps/cli/dist/index.js",
    "check": "turbo run typecheck lint test",
    "test": "turbo run test",
    "test:visual": "turbo run test:visual",
    "build": "turbo run build",
    "docs:gen": "turbo run build --filter=@tyto/core && pnpm --filter @tyto/docs-gen run generate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "eslint --fix --max-warnings 0",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.5.0",
    "prettier": "^3.6.2",
    "tsup": "^8.5.0",
    "turbo": "^2.5.8",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^5.0.0"
  }
}
