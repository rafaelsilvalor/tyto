{
  "name": "@tyto/brief-lang",
  "version": "0.5.3",
  "type": "module",
  "description": "Lezer grammar and parser for the brief language; also powers editor highlighting.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "generate:parser": "lezer-generator src/brief.grammar -o src/brief.parser.js",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@lezer/common": "^1.5.2",
    "@lezer/highlight": "^1.2.3",
    "@lezer/lr": "^1.4.10",
    "@tyto/core": "workspace:*",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@lezer/generator": "^1.8.0"
  }
}
