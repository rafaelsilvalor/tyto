// The brief language (docs/brief-language.md, ADR 0004).
//
// Line-oriented on the outside, inline markup on the inside, and the two want opposite
// whitespace rules: the space between `::slide` and `{destaque}` is noise, the space in
// `Direito **Constitucional**` is content. So nothing is skipped globally — every space
// that may be dropped is written out, and every space that survives is part of a Text
// token.

@top Brief { Frontmatter? line* }

line { Comment | Directive | BlankLine }

// `{…}` straight after the name is an adjustment list. A mark opens the same way, so
// something has to break the tie, and the first group after a directive name being an
// adjustment is what `docs/brief-language.md` shows. A mark that needs to lead a line
// goes in an indented body, where `bodyInline` allows it.
Directive {
  directiveMark Namespace? Name
  Adjustments?
  InlineBody?
  BodyLine*
  lineEnd
}

// A brief whose last line has no line break is still a brief — plenty of editors save
// files that way. Rather than let that become an error node at EOF, the tokenizer hands
// out a zero-length break there, the same trick Lezer's own grammars use for automatic
// semicolons.
lineEnd { newline | virtualNewline }

// The leading space belongs to the adjustment list rather than to the body. After the
// name both start with the same space token, and one more token settles it: a `{` next
// means adjustments, anything else means the space was the first thing in the body.
Adjustments {
  adjustmentsStart space? (Adjustment (adjustmentSep space? Adjustment)*)? space? braceClose
}

// LR(1) cannot see past a space to know whether `:` or `}` comes next, so there is no
// space before the colon. `{cor: laranja}` is the form the spec writes.
Adjustment { AdjustmentName (valueSep space? AdjustmentValue)? }

// A block body is a run of indented lines, and `blockIndent` is the line break plus the
// indent as one token. That is what makes the indent recognisable at all: on its own it
// is the same two spaces as any space inside text, and only the newline in front of it
// says otherwise. A blank line therefore ends the block — the character after its break
// is another break, not an indent — which is also how the spec's example separates one
// directive from the next.
BodyLine { blockIndent BlockText }

InlineBody { headInline bodyInline* }

BlockText { bodyInline+ }

bodyInline { headInline | Mark }

// Emphasis nests, but never inside its own kind: bold may hold italic, italic may hold
// bold, and neither may hold itself. Its own kind is what makes `*a*b*c*` ambiguous — is
// the second star closing the first or opening a nested one? Markdown answers that with
// delimiter runs, which an LR parser cannot do, and is why @lezer/markdown is hand-written.
//
// The same limit shows at the seam of two closers: `**bold *italic***` does not parse,
// because longest match reads the trailing `***` as `**` then `*` and no lookahead could
// prefer the other split. Write `**bold *italic* **` or reorder the runs (ADR 0015).
headInline { Text | Space | Bold | Italic | Break | EscapedDirective }

Bold { boldMark boldInline+ boldMark }

boldInline { Text | Space | Italic | Break | EscapedDirective }

Italic { italicMark italicInline+ italicMark }

italicInline { Text | Space | Bold | Break | EscapedDirective }

Mark { braceOpen MarkName valueSep MarkValue braceClose headInline+ markClose }

// Text cannot start with a space — `blockIndent` owns the one at the head of a body line
// — so the space between `*Legenda*` and the word after it needs a node of its own.
Space { space }

BlankLine { newline }

@tokens {
  directiveMark { "::" }

  identifier { $[a-zA-Z_] $[a-zA-Z0-9_-]* }
  value { $[a-zA-Z0-9_-]+ }

  // The separator is inside the token on purpose. `Namespace` and `Name` are the same
  // shape, so after `::` the tokenizer cannot tell `ai` in `::ai/caption` from `titulo`
  // in `::titulo` without looking past the identifier — and a Lezer token has no
  // lookahead. Ending the token at the slash makes `ai/` longer than `ai`, so longest
  // match decides it. The node's range therefore includes the `/`; `parseBrief` strips it.
  Namespace { identifier "/" }
  Name { identifier }
  AdjustmentName { identifier }
  AdjustmentValue { value }
  MarkName { identifier }
  MarkValue { value }

  braceOpen { "{" }

  // The space before the brace is part of the token, which is what settles ` {cor:azul}`
  // after a directive name: as a parser decision it is a real ambiguity — adjustments, or
  // a space followed by a mark — but as a token it is just longest match, and ` {` beats
  // the lone space every time.
  adjustmentsStart { $[ 	]* "{" }
  braceClose { "}" }
  adjustmentSep { "," }
  valueSep { ":" }

  // Longer than braceOpen, so longest match closes a mark rather than opening one.
  markClose { "{/}" }

  boldMark { "**" }
  italicMark { "*" }

  // A trailing backslash is a hard line break; `\::` is how body text starts with a
  // literal `::` instead of becoming a directive.
  EscapedDirective { "\\::" }
  Break { "\\" }

  // Everything that is not markup. It may not begin with a space: at the start of a line
  // that space belongs to `blockIndent`, and the two would be indistinguishable.
  Text { ![ \t*{}\\\n] ![*{}\\\n]* }

  Comment { "//" ![\n]* }

  newline { "\n" }
  blockIndent { "\n" $[ \t]+ }
  space { $[ \t]+ }

  @precedence { adjustmentsStart, space }
  @precedence { blockIndent, newline }
  @precedence { Namespace, Name }
  @precedence { markClose, braceOpen }
  @precedence { boldMark, italicMark }
  @precedence { EscapedDirective, Break }
  @precedence { Comment, directiveMark, Text }
}

@external tokens frontmatterBlock from "./tokens.js" { Frontmatter }

@external tokens endOfInput from "./tokens.js" { virtualNewline }
