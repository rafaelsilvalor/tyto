{
  "name": "@tyto/command-line",
  "version": "0.2.1",
  "type": "module",
  "description": "The tyto command tree, built around an environment each app fills (ADR 0159).",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tyto/core": "workspace:*",
    "@tyto/export-html": "workspace:*",
    "@tyto/export-svg": "workspace:*",
    "@tyto/fonts": "workspace:*",
    "@tyto/google-fonts": "workspace:*",
    "@tyto/io": "workspace:*",
    "@tyto/pipeline": "workspace:*",
    "@tyto/plugin-api": "workspace:*",
    "@tyto/raster": "workspace:*",
    "@tyto/template-lang": "workspace:*",
    "@tyto/templates": "workspace:*",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@tyto/recipe": "workspace:*",
    "esbuild": "0.27.7",
    "vitest": "^5.0.1"
  }
}
