{
  "name": "@tyto/fonts",
  "version": "0.1.0",
  "type": "module",
  "description": "The fonts Tyto ships, and the reader that hands them to the exporters and to measurement.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "fonts"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run"
  },
  "devDependencies": {
    "@tyto/core": "workspace:*",
    "vitest": "^5.0.1"
  }
}
