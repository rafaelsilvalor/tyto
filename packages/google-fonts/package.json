{
  "name": "@tyto/google-fonts",
  "version": "0.1.9",
  "type": "module",
  "description": "A built-in font source: a family this machine lacks is fetched from Google Fonts once, when Google serves it.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tyto/core": "workspace:*",
    "@tyto/plugin-api": "workspace:*"
  }
}
