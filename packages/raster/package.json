{
  "name": "@tyto/raster",
  "version": "0.0.0",
  "type": "module",
  "description": "Rasterizer port and its Chromium adapters.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests",
    "test:visual": "vitest run --config vitest.visual.config.ts"
  },
  "peerDependencies": {
    "playwright": ">=1.55.0"
  },
  "peerDependenciesMeta": {
    "playwright": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/pngjs": "^6.0.5",
    "@tyto/core": "workspace:*",
    "@tyto/export-html": "workspace:*",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.63.0",
    "pngjs": "^7.0.0",
    "vitest": "^3.2.4"
  }
}
