{
  "version": 1,
  "artworks": [
    {
      "id": "shadow",
      "label": "One blur, read as a standard deviation by both exporters (ADR 0156, 2026-10-31 note)",
      "frames": [
        {
          "format": "square",
          "size": { "w": 240, "h": 240 },
          "background": { "kind": "solid", "color": { "r": 240, "g": 236, "b": 228 } },
          "children": [
            {
              "kind": "rect",
              "id": "plain",
              "name": "no spread: drop-shadow() in HTML, feDropShadow in SVG",
              "transform": { "x": 20, "y": 20 },
              "size": { "w": 80, "h": 50 },
              "radius": [0, 0, 0, 0],
              "fill": { "kind": "solid", "color": { "r": 255, "g": 255, "b": 255 } },
              "effects": [
                {
                  "kind": "shadow",
                  "x": 6,
                  "y": 10,
                  "blur": 8,
                  "spread": 0,
                  "color": { "r": 0, "g": 0, "b": 0, "a": 0.6 }
                }
              ]
            },
            {
              "kind": "rect",
              "id": "spread",
              "name": "a negative spread: the inline filter in HTML, the long form in SVG",
              "transform": { "x": 130, "y": 20 },
              "size": { "w": 80, "h": 50 },
              "radius": [0, 0, 0, 0],
              "fill": { "kind": "solid", "color": { "r": 255, "g": 255, "b": 255 } },
              "effects": [
                {
                  "kind": "shadow",
                  "x": 6,
                  "y": 10,
                  "blur": 8,
                  "spread": -4,
                  "color": { "r": 0, "g": 0, "b": 0, "a": 0.6 }
                }
              ]
            },
            {
              "kind": "rect",
              "id": "small",
              "name": "a blur wider than half the node, which a filter region of -50% would cut",
              "transform": { "x": 40, "y": 150 },
              "size": { "w": 24, "h": 24 },
              "radius": [0, 0, 0, 0],
              "fill": { "kind": "solid", "color": { "r": 255, "g": 255, "b": 255 } },
              "effects": [
                {
                  "kind": "shadow",
                  "x": 0,
                  "y": 0,
                  "blur": 10,
                  "spread": 0,
                  "color": { "r": 0, "g": 0, "b": 0, "a": 0.8 }
                }
              ]
            },
            {
              "kind": "rect",
              "id": "blurred",
              "name": "a layer blur: blur() in HTML, feGaussianBlur in SVG",
              "transform": { "x": 140, "y": 130 },
              "size": { "w": 60, "h": 60 },
              "radius": [0, 0, 0, 0],
              "fill": { "kind": "solid", "color": { "r": 255, "g": 89, "b": 0 } },
              "effects": [{ "kind": "blur", "radius": 5 }]
            }
          ]
        }
      ]
    }
  ]
}
