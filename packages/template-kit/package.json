{
  "name": "@tyto/template-kit",
  "version": "0.4.1",
  "type": "module",
  "description": "Arrangement helpers a template written in TypeScript composes with.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tyto/brief-lang": "workspace:*",
    "@tyto/core": "workspace:*",
    "@tyto/export-html": "workspace:*"
  }
}
