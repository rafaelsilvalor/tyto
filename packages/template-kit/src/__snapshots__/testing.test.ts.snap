      .tyto-frame { position: relative; overflow: hidden; }
      .tyto-node { position: absolute; left: 0; top: 0; transform-origin: 0 0; }
      .tyto-node > svg { display: block; width: 100%; height: 100%; }
      @font-face { font-family: "Inter"; font-weight: 700; font-style: normal; src: url("tyto-test-font:Inter-700-normal"); }
      .tyto-frame { width: 1080px; height: 1350px; background-color: #0c2340; }
      #artwork-1\\.grid\\.titulo { transform: matrix(1, 0, 0, 1, 80, 80); width: 920px; display: flex; flex-direction: column; justify-content: flex-start; text-align: left; font-family: "Inter"; font-size: 96px; font-weight: 700; line-height: 1.2; white-space: pre-wrap; overflow: hidden; }
    </style>
  </head>
  <body>
    <div class="tyto-frame"><div id="artwork-1.grid.titulo" class="tyto-node"><div><span style="font-family: &quot;Inter&quot;; font-size: 96px; font-weight: 700; color: #ffffff">Turma nova de Direito</span></div></div></div>
  </body>
</html>
"
`;
