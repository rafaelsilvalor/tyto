{
  "name": "@tyto/templates",
  "version": "0.5.1",
  "type": "module",
  "description": "Built-in templates, shipped as a template-pack plugin.",
  "license": "UNLICENSED",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "templates"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tyto/core": "workspace:*",
    "@tyto/template-kit": "workspace:*"
  }
}
