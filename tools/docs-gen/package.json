{
  "name": "@tyto/docs-gen",
  "private": true,
  "type": "module",
  "description": "Generates the reference docs that are derived from code, such as the diagnostic catalog and the manual's Reference pages.",
  "license": "UNLICENSED",
  "scripts": {
    "generate": "node --experimental-strip-types src/generate.ts && vitest run --update src/reference src/gallery",
    "template-shots": "node --experimental-strip-types src/gallery/template-shots.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@tyto/core": "workspace:*",
    "@tyto/editor": "workspace:*",
    "@tyto/io": "workspace:*",
    "@tyto/plugin-api": "workspace:*",
    "@tyto/theme-pack": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tyto/cli": "workspace:*",
    "@tyto/command-line": "workspace:*",
    "vitest": "^5.0.1"
  }
}
