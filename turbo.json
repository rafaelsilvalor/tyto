{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build", "generate:parser"],
      // `out/**` is `apps/desktop`, the one package that does not build to `dist` —
      // electron-vite writes three bundles there and the name is not configurable per
      // environment. Declaring only `dist/**` did not make that build uncacheable, which
      // would have been harmless; it made it cacheable with nothing in the cache, so a
      // second `pnpm build` printed `@tyto/desktop:build: cache hit, replaying logs` and
      // left `apps/desktop/out` absent. `desktop.yml` builds and then packages, so the
      // hit that restores nothing is an installer built around an empty app — measured by
      // deleting `out/` and running the task twice (TYTO-15).
      "outputs": ["dist/**", "out/**"]
    },
    "typecheck": {
      "dependsOn": ["^build", "generate:parser"],
      "outputs": []
    },
    "lint": {
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build", "generate:parser"],
      "outputs": []
    },
    "test:visual": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "generate:parser": {
      "outputs": ["src/*.parser.js", "src/*.parser.terms.js"]
    },
    "test:desktop": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    },
    // Packages the app with electron-builder and launches what came out, so it needs the
    // same build `test:desktop` does and must never be cached: the thing it measures is a
    // packaging step that runs outside Turborepo's view.
    "test:package": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "outputs": []
    }
  }
}
